# Groq requests allowed per IP per minute (default 10)
GROQ_RATE_LIMIT_PER_MIN=10

# Required
GROQ_API_KEY=
# Needed for LinkedIn login/posting (redirect URI must match your LinkedIn app)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
